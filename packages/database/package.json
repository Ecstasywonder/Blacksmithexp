{
  "name": "@chairly/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:migrate:test": "tsx src/migrate.ts",
    "test": "tsx --test --test-concurrency=1 src/public-booking-catalog.integration.test.ts src/appointments.integration.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chairly/domain": "workspace:*",
    "drizzle-orm": "^0.44.5",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2"
  }
}
