{
  "name": "chairly",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @chairly/web dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm --filter @chairly/database exec tsx --test ../../apps/web/src/server/chairly-session.test.ts && pnpm --filter \"!@chairly/e2e\" -r --if-present test",
    "test:e2e": "pnpm --filter @chairly/e2e test",
    "booking-slice:setup": "node tools/booking-slice.mjs setup",
    "booking-slice:verify": "node tools/booking-slice.mjs verify",
    "booking-slice:check": "node tools/booking-slice.mjs check",
    "booking-slice:teardown": "node tools/booking-slice.mjs teardown",
    "container:build": "docker compose build",
    "container:up": "docker compose up --build --detach --wait",
    "container:logs": "docker compose logs --follow web postgres",
    "container:ps": "docker compose ps",
    "container:verify": "docker compose build && docker compose -f compose.verify.yml run --build --rm verify",
    "container:migrate": "docker compose run --rm migrate",
    "container:seed": "docker compose run --rm migrate pnpm --filter @chairly/database booking-slice:reset",
    "container:down": "docker compose down --remove-orphans",
    "container:reset": "docker compose down --volumes --remove-orphans",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @chairly/database db:generate",
    "db:migrate": "pnpm --filter @chairly/database db:migrate",
    "db:migrate:test": "pnpm --filter @chairly/database db:migrate:test"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
