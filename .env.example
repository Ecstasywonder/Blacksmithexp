# Server-only database connection. Runtime role must not own schema objects.
DATABASE_URL=postgresql://chairly_app:local-only@localhost:5432/chairly
MIGRATION_DATABASE_URL=postgresql://chairly_migrator:local-only@localhost:5432/chairly

# Authentication adapter
AUTH_ISSUER_URL=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_SESSION_SECRET=

# Public URL and signed customer-link secret
APP_ORIGIN=http://localhost:3000
CUSTOMER_LINK_SECRET=

# Notification and media adapters
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
ERROR_TRACKING_DSN=

